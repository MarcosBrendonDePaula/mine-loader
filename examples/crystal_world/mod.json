{
  "schema": 1,
  "id": "crystal_world",
  "name": "Crystal World",
  "version": "0.1.0",
  "description": "Mod sem main.lua: o manifesto e o indice e cada bloco aponta seu proprio script.",
  "authors": [
    "Minecraft Lua Loader"
  ],
  "permissions": [
    "chat.send",
    "player.read",
    "world.read",
    "world.write"
  ],
  "creative_tab": {
    "register": true,
    "id": "main",
    "name": "Crystal World",
    "icon": "crystal_world:crystal_block"
  },
  "items": [
    {
      "$import": "parts/items/crystal_shard.json"
    }
  ],
  "blocks": [
    {
      "$import": "parts/blocks/crystal_block.json"
    }
  ],
  "structures": [
    {
      "$import": "parts/structures/crystal_tower.json"
    }
  ],
  "enabled": true
}

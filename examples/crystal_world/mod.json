        "default": {
          "charge": "0"
        }
      },
      "render": {
        "model": "cube_all",
        "texture": {
          "source": "local",
          "path": "assets/crystal_world/textures/block/crystal_block.png",
          "fallback": "minecraft:block/amethyst_block"
        }
      },
      "loot": {
        "mode": "item",
        "item": "crystal_world:crystal_shard",
        "count": 4
      },
      "tags": [
        "minecraft:mineable/pickaxe"
      ],
      "item": {
        "register": true,
        "rarity": "uncommon"
      }
    }
  ],
  "enabled": true

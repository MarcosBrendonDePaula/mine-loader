{
  "schema": 1,
  "id": "crystal_world",
  "name": "Crystal World",
  "version": "0.1.0",
  "description": "Exemplo de mod dividido em arquivos, com estrutura declarada em JSON.",
  "authors": [
    "Minecraft Lua Loader"
  ],
  "entrypoint": "main.lua",
  "permissions": [
    "chat.send",
    "player.read",
    "world.read",
    "world.write"
  ],
  "events": {
    "loader_ready": "on_loader_ready",
    "block_used": "on_block_used"
  },
  "creative_tab": {
    "register": true,
    "id": "main",
    "name": "Crystal World",
    "icon": "crystal_world:crystal_block"
  },
  "items": [
    {
      "$import": "parts/items/crystal_shard.json"
    }
  ],
  "blocks": [
    {
      "$import": "parts/blocks/crystal_block.json"
    }
  ],
  "structures": [
    {
      "$import": "parts/structures/crystal_tower.json"
    }
  ],
  "enabled": true
}

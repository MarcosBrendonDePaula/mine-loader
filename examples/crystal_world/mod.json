{
  "schema": 1,
  "id": "crystal_world",
  "name": "Crystal World",
  "version": "0.1.0",
  "description": "Segundo mod de exemplo, usado para validar a carga de varios mods.",
  "authors": [
    "Minecraft Lua Loader"
  ],
  "entrypoint": "main.lua",
  "permissions": [
    "chat.send",
    "player.read",
    "world.write"
  ],
  "events": {
    "loader_ready": "on_loader_ready",
    "block_used": "on_block_used"
  },
  "creative_tab": {
    "register": true,
    "id": "main",
    "name": "Crystal World",
    "icon": "crystal_world:crystal_block"
  },
  "items": [
    {
      "id": "crystal_shard",
      "name": "Fragmento de Cristal",
      "max_stack_size": 32,
      "rarity": "uncommon",
      "texture": {
        "source": "local",
        "path": "assets/crystal_world/textures/item/crystal_shard.png",
        "fallback": "minecraft:item/amethyst_shard"
      }
    }
  ],
  "blocks": [
    {
      "id": "crystal_block",
      "name": "Bloco de Cristal",
      "material": {
        "map_color": "blue",
        "sound": "glass"
      },
      "settings": {
        "hardness": 3.0,
        "resistance": 3.0,
        "requires_tool": true,

      "cubes": [
        { "from": [-5, -14, -5], "size": [10, 10, 10], "uv": [0, 0] },
        { "from": [-2, -19, -2], "size": [4, 6, 4], "uv": [0, 0], "inflate": -0.2 }
      ]
    },

    "body": {
      "pivot": [0, -7, 0],
      "cubes": [
        { "from": [-5, -2, -3], "size": [10, 16, 6], "uv": [0, 40] },
        { "from": [-7, 0, -1], "size": [14, 3, 2], "uv": [0, 70] }
      ]
    },

    "right_arm": {
      "pivot": [0, -7, 0],
      "cubes": [
        { "from": [-9, -2, -2], "size": [4, 22, 4], "uv": [60, 21] }
      ]
    },

    "left_arm": {
      "pivot": [0, -7, 0],
      "cubes": [
        { "from": [5, -2, -2], "size": [4, 22, 4], "uv": [60, 58] }

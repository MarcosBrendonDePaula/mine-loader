{
  "schema": 1,
  "id": "hello_lua",
  "name": "Hello Lua",
  "version": "0.1.0",
  "description": "Mod de exemplo para o Minecraft Lua Loader.",
  "authors": [
    "Minecraft Lua Loader"
  ],
  "entrypoint": "main.lua",
  "permissions": [
    "chat.send",
    "player.read",
    "world.write"
  ],
  "events": {
    "loader_ready": "on_loader_ready",
    "server_started": "on_server_started",
    "player_joined": "on_player_joined",
    "block_used": "on_block_used",
    "block_attacked": "on_block_attacked"
  },
  "blocks": [
    {
      "id": "ruby_block",
      "name": "Bloco de Rubi",
      "type": "generic",
      "material": {
        "map_color": "red",
        "sound": "stone",
        "instrument": "harp",
        "piston_behavior": "normal",
        "burnable": false,
        "replaceable": false,
        "solid": true,
        "opaque": true
      },
      "settings": {
        "hardness": 5.0,
        "resistance": 6.0,
        "requires_tool": true,
        "collidable": true,
        "random_ticks": false,
        "luminance": 0,
        "slipperiness": 0.6,
        "velocity_multiplier": 1.0,
        "jump_velocity_multiplier": 1.0,
        "block_break_particles": true,
        "dynamic_bounds": false,
        "solid": true,
        "non_opaque": false,
        "break_instantly": false,
        "offset": "none",
        "drops_nothing": false
      },
      "state": {
        "properties": [
          {
            "name": "polished",
            "type": "bool",
            "values": [
              "false",
              "true"
            ]
          }
        ],
        "default": {
          "polished": "false"
        }
      },
      "shape": {
        "collision": "full_cube",
        "outline": "full_cube",
        "visual": "full_cube",
        "dynamic": false
      },
      "placement": {
        "can_replace": false,
        "can_place_at": true,
        "facing": "none",
        "waterloggable": false,
        "rotate_with_player": false
      },
      "render": {
        "model": "cube_all",
        "texture": {
          "source": "local",
          "path": "assets/hello_lua/textures/block/ruby_block.png",
          "fallback": "minecraft:block/stone"
        },
        "variant_textures": {
          "0": {
            "source": "local",
            "path": "assets/hello_lua/textures/block/ruby_block.png",
            "fallback": "minecraft:block/stone"
          },
          "1": {
            "source": "local",
            "path": "assets/hello_lua/textures/block/ruby_block_alt.png",
            "fallback": "minecraft:block/stone"
          }
        },
        "render_layer": "solid",
        "translucent": false,
        "cutout": false,
        "emissive": false
      },
      "loot": {
        "mode": "item",
        "item": "hello_lua:ruby",
        "count": 2
      },
      "tags": [
        "minecraft:mineable/pickaxe",
        "minecraft:needs_iron_tool"
      ],
      "item": {
        "register": true,
        "max_stack_size": 64,
        "max_damage": 0,
        "rarity": "common",
        "fire_resistant": false
      },
      "behavior": {
        "on_random_tick": "on_block_random_tick"
      }
    }
  ],
  "enabled": true,
  "creative_tab": {
    "register": true,
    "id": "main",
    "name": "Hello Lua",
    "icon": "hello_lua:ruby_block"
  },
  "items": [
    {
      "id": "ruby",
      "name": "Rubi",
      "max_stack_size": 64,
      "rarity": "rare",
      "fire_resistant": false,
      "texture": {
        "source": "local",
        "path": "assets/hello_lua/textures/item/ruby.png",
        "fallback": "minecraft:item/redstone"
      }
    }
  ]
}

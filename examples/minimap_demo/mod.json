{
  "schema": 1,
  "id": "minimap_demo",
  "name": "Minimap Demo",
  "version": "0.1.0",
  "description": "Protótipo de minimap declarativo em HUD, com configuração persistente aberta pela tecla M.",
  "entrypoint": "main.lua",
  "permissions": ["chat.send", "player.read", "player.modify", "player.menu", "world.read", "server.command.register", "client.input.register"],
  "keybinds": [
    { "id": "toggle", "key": "key.keyboard.m", "category": "minimap_demo" }
  ],
  "requires": {
    "domains": {
      "world": "1.0.0",
      "player": "1.0.0",
      "ui": "1.0.0",
      "client": "1.0.0"
    },
    "capabilities": {
      "world.block_state.read": "1.0.0",
      "ui.menu": "1.0.0",
      "client.input.keybind": "1.0.0",
      "server.command.schema": "1.0.0",
      "player.data.read": "1.0.0",
      "player.data.write": "1.0.0"
    }
  },
  "events": {
    "player_joined": "on_player_joined"
  },
  "enabled": true
}

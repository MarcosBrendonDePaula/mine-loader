{
  "schemaVersion": 1,
  "id": "lua_loader",
  "version": "${version}",
  "name": "Minecraft Lua Loader",
  "description": "Núcleo de um modloader declarativo com mods JSON e lógica Lua.",
  "authors": [
    "Minecraft Lua Loader"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.lualoader.LuaLoaderMod"
    ],
    "fabric-gametest": [
      "dev.lualoader.gametest.BlockInteractionGameTest",
      "dev.lualoader.gametest.BlockInventoryGameTest",
      "dev.lualoader.gametest.EntityRegistrationGameTest"
    ],
    "client": [
      "dev.lualoader.client.LuaLoaderClient"
    ]
  },
  "mixins": [
    "lua_loader.mixins.json",
    {
      "config": "lua_loader.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.4",
    "java": ">=21",
    "fabric-api": "*"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/minecraft-lua-loader/mod.schema.json",
  "title": "Minecraft Lua Loader Mod Manifest",
  "description": "Manifesto declarativo para mods com blocos, recursos e lógica Lua.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "entrypoint"
  ],
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[^/\\\\][^:]*\\.lua$"
    },
    "authors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "chat.send",
          "player.read",
          "server.read",
          "server.command.register",
          "world.write"
        ]
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "propertyNames": {
        "enum": [
          "loader_ready",
          "server_started",
          "server_stopped",
          "player_joined",
          "tick"
        ]
      }
    },
    "blocks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "items": {
      "type": "array",
      "description": "Itens que nao pertencem a um bloco.",
      "items": {
        "$ref": "#/$defs/itemEntry"
      }
    },
    "creative_tab": {
      "$ref": "#/$defs/creativeTab"
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "enum": [
            "generic",
            "falling",
            "slab",
            "stairs",
            "wall",
            "fence",
            "fence_gate",
            "door",
            "trapdoor",
            "button",
            "pressure_plate",
            "plant",
            "crop",
            "fluid",
            "redstone",
            "block_entity"
          ]
        },
        "base": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_/.-]+$"
        },
        "material": {
          "$ref": "#/$defs/material"
        },
        "settings": {
          "$ref": "#/$defs/settings"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "shape": {
          "$ref": "#/$defs/shape"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "render": {
          "$ref": "#/$defs/render"
        },
        "loot": {
          "$ref": "#/$defs/loot"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+:[a-z0-9_/.-]+$"
          }
        },
        "item": {
          "$ref": "#/$defs/item"
        },
        "behavior": {
          "$ref": "#/$defs/behavior"
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "map_color": {
          "type": "string",
          "default": "stone"
        },
        "sound": {
          "type": "string",
          "default": "stone"
        },
        "instrument": {
          "type": "string",
          "default": "harp"
        },
        "piston_behavior": {
          "enum": [
            "normal",
            "block",
            "destroy",
            "push_only"
          ]
        },
        "burnable": {
          "type": "boolean"
        },
        "flammability": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "burn_spread": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "replaceable": {
          "type": "boolean"
        },
        "liquid": {
          "type": "boolean"
        },
        "air": {
          "type": "boolean"
        },
        "solid": {
          "type": "boolean",
          "default": true
        },
        "opaque": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hardness": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "resistance": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "requires_tool": {
          "type": "boolean"
        },
        "collidable": {
          "type": "boolean",
          "default": true
        },
        "no_collision": {
          "type": "boolean"
        },
        "random_ticks": {
          "type": "boolean"
        },
        "luminance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "slipperiness": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "velocity_multiplier": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "jump_velocity_multiplier": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "block_break_particles": {
          "type": "boolean",
          "default": true
        },
        "dynamic_bounds": {
          "type": "boolean"
        },
        "solid": {
          "type": "boolean",
          "default": true
        },
        "non_opaque": {
          "type": "boolean"
        },
        "break_instantly": {
          "type": "boolean"
        },
        "offset": {
          "enum": [
            "none",
            "xz",
            "xyz"
          ]
        },
        "drops_nothing": {
          "type": "boolean"
        },
        "drops_like": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_/.-]+$"
        },
        "required_features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "properties": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "values"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "type": {
                "enum": [
                  "boolean",
                  "int",
                  "enum",
                  "direction",
                  "string"
                ]
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": [
                    "string",
                    "integer",
                    "boolean"
                  ]
                }
              }
            }
          }
        },
        "default": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          }
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collision": {
          "type": "string"
        },
        "outline": {
          "type": "string"
        },
        "visual": {
          "type": "string"
        },
        "dynamic": {
          "type": "boolean"
        },
        "boxes": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "can_replace": {
          "type": "boolean"
        },
        "can_place_at": {
          "type": "boolean",
          "default": true
        },
        "facing": {
          "enum": [
            "none",
            "horizontal",
            "all"
          ]
        },
        "waterloggable": {
          "type": "boolean"
        },
        "rotate_with_player": {
          "type": "boolean"
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "texture": {
          "$ref": "#/$defs/texture"
        },
        "variant_textures": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/texture"
          }
        },
        "render_layer": {
          "enum": [
            "solid",
            "cutout",
            "cutout_mipped",
            "translucent"
          ]
        },
        "translucent": {
          "type": "boolean"
        },
        "cutout": {
          "type": "boolean"
        },
        "emissive": {
          "type": "boolean"
        },
        "tint": {
          "type": "string"
        }
      }
    },
    "texture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "enum": [
            "local",
            "remote"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^[^/\\\\][^:]*\\.(png|jpg|jpeg)$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216,
          "default": 1048576
        },
        "fallback": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_/.-]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "local"
              }
            }
          },
          "then": {
            "required": [
              "path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "remote"
              }
            }
          },
          "then": {
            "required": [
              "url"
            ]
          }
        }
      ]
    },
    "loot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "self",
            "nothing",
            "like",
            "item",
            "table"
          ]
        },
        "item": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_/.-]+$"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "table": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_/.-]+$"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "register": {
          "type": "boolean",
          "default": true
        },
        "max_stack_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_damage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "rarity": {
          "enum": [
            "common",
            "uncommon",
            "rare",
            "epic"
          ]
        },
        "fire_resistant": {
          "type": "boolean"
        }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on_place": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "on_break": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "on_use": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "on_random_tick": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "on_neighbor_update": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      }
    },
    "itemEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "max_stack_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 64
        },
        "max_damage": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Maior que zero exige max_stack_size igual a 1."
        },
        "rarity": {
          "enum": [
            "common",
            "uncommon",
            "rare",
            "epic"
          ],
          "default": "common"
        },
        "fire_resistant": {
          "type": "boolean",
          "default": false
        },
        "texture": {
          "$ref": "#/$defs/texture"
        },
        "model": {
          "type": "string",
          "default": "item/generated"
        },
        "behavior": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "on_use": {
              "type": "string"
            }
          }
        }
      }
    },
    "creativeTab": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "register": {
          "type": "boolean",
          "default": true
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$",
          "default": "main"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
          "description": "Item mostrado como icone. Vazio usa o primeiro conteudo declarado."
        }
      }
    }
  }
}

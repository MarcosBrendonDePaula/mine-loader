{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/minecraft-lua-loader/mod.schema.json",
  "title": "Minecraft Lua Loader Mod Manifest",
  "description": "Manifesto declarativo para mods com blocos, recursos e lógica Lua.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "version"
  ],
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[^/\\\\][^:]*\\.lua$"
    },
    "authors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "chat.send",
          "player.read",
          "player.inventory",
          "player.move",
          "player.menu",
          "player.modify",
          "server.read",
          "server.command.register",
          "client.input.register",
          "client.camera.register",
          "world.read",
          "world.write",
          "world.explode",
          "world.lightning",
          "world.containers",
          "entity.read",
          "entity.spawn",
          "entity.modify",
          "entity.register",
          "server.install"
        ]
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "propertyNames": {
        "enum": [
          "loader_ready",
          "server_started",
          "server_stopped",
          "player_joined",
          "player_left",
          "tick",
          "mod_reloaded",
          "client_screen_opened",
          "client_screen_closed",
          "block_used",
          "block_attacked",
          "block_placed",
          "block_broken",
          "block_random_tick",
          "block_neighbor_update",
          "block_scheduled",
          "entity_spawned",
          "entity_damaged",
          "entity_died",
          "entity_tamed",
          "item_used",
          "item_used_on_block",
          "menu_click",
          "menu_closed"
        ]
      }
    },
    "cameras": {
      "type": "object",
      "description": "Câmeras lógicas client-side; o bridge gere a textura física.",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,31}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/cameraDefinition"
      }
    },
    "commands": {
      "type": "object",
      "description": "Árvores estáticas publicadas depois de /mod.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,31}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/commandDefinition"
      }
    },
    "blocks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "items": {
      "type": "array",
      "description": "Itens que nao pertencem a um bloco.",
      "items": {
        "$ref": "#/$defs/itemEntry"
      }
    },
    "creative_tab": {
      "$ref": "#/$defs/creativeTab"
    },
    "structures": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/structure"
          },
          {
            "$ref": "#/$defs/importRef"
          }
        ]
      }
    },
    "dependencies": {
      "type": "object",
      "description": "Mods necessarios, no formato id -> versao minima.",
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
      }
    },
    "requires": {
      "$ref": "#/$defs/requires"
    },
    "remote_base": {
      "type": "string",
      "format": "uri",
      "description": "Base https para resolver caminhos relativos que nao existam no disco."
    }
  },
  "$defs": {
    "cameraDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projection": {
          "const": "orthographic",
          "default": "orthographic"
        },
        "source": {
          "const": "world",
          "default": "world"
        },
        "anchor": {
          "const": "player",
          "default": "player"
        },
        "orientation": {
          "enum": ["north", "player"],
          "default": "north"
        },
        "resolution": {
          "type": "integer",
          "minimum": 16,
          "maximum": 192,
          "default": 96
        },
        "radius": {
          "type": "integer",
          "minimum": 8,
          "maximum": 96,
          "default": 48
        },
        "update_ticks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40,
          "default": 5
        },
        "output": {
          "const": "texture",
          "default": "texture"
        }
      }
    },
    "commandDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["children"],
      "properties": {
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/commandNode"
          }
        }
      }
    },
    "commandNode": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["literal"],
          "not": { "required": ["argument"] }
        },
        {
          "required": ["argument"],
          "not": { "required": ["literal"] }
        }
      ],
      "properties": {
        "literal": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,31}$"
        },
        "argument": {
          "$ref": "#/$defs/commandArgument"
        },
        "executes": {
          "type": "boolean"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commandNode"
          }
        }
      }
    },
    "commandArgument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,31}$"
        },
        "type": {
          "enum": ["word", "string", "greedy_string", "integer", "double", "boolean"],
          "default": "word"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "suggestions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "enum": [
            "generic",
            "falling",
            "slab",
            "stairs",
            "wall",
            "fence",
            "fence_gate",
            "door",
            "trapdoor",
            "button",
            "pressure_plate",
            "plant",
            "crop",
            "fluid",
            "redstone",
            "block_entity"
          ]
        },
        "base": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_/.-]+$"
        },
        "material": {
          "$ref": "#/$defs/material"
        },
        "settings": {
          "$ref": "#/$defs/settings"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "shape": {
          "$ref": "#/$defs/shape"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "render": {
          "$ref": "#/$defs/render"
        },
        "loot": {
          "$ref": "#/$defs/loot"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+:[a-z0-9_/.-]+$"
          }
        },
        "item": {
          "$ref": "#/$defs/item"
        },
        "behavior": {
          "$ref": "#/$defs/behavior"
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "map_color": {
          "type": "string",
          "default": "stone"
        },
        "sound": {
          "type": "string",
          "default": "stone"
        },
        "instrument": {
          "type": "string",
          "default": "harp"
        },
        "piston_behavior": {
          "enum": [
            "normal",
            "block",
            "destroy",
            "push_only"
          ]
        },
        "burnable": {
          "type": "boolean"
        },
        "flammability": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "burn_spread": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "replaceable": {
          "type": "boolean"
        },
        "liquid": {
          "type": "boolean"
        },
        "air": {
          "type": "boolean"
        },
        "solid": {
          "type": "boolean",
          "default": true
        },
        "opaque": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hardness": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "resistance": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "requires_tool": {
          "type": "boolean"
        },
        "collidable": {
          "type": "boolean",
          "default": true
        },
        "no_collision": {
          "type": "boolean"
        },
        "random_ticks": {
          "type": "boolean"
        },
        "luminance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "slipperiness": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "velocity_multiplier": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "jump_velocity_multiplier": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "block_break_particles": {
          "type": "boolean",
          "default": true
        },
        "dynamic_bounds": {
          "type": "boolean"
        },
        "solid": {
          "type": "boolean",
          "default": true
        },
        "non_opaque": {
          "type": "boolean"
        },
        "break_instantly": {
          "type": "boolean"
        },
        "offset": {
          "enum": [
            "none",
            "xz",
            "xyz"
          ]
        },
        "drops_nothing": {
          "type": "boolean"
        },
        "drops_like": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_/.-]+$"
        },
        "required_features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "properties": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "values"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "type": {
                "enum": [
                  "boolean",
                  "int",
                  "enum",
                  "direction",
                  "string"
                ]
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": [
                    "string",
                    "integer",
                    "boolean"
                  ]
                }
              }
            }
          }
        },
        "default": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          }
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collision": {
          "type": "string"
        },
        "outline": {
          "type": "string"
        },
        "visual": {
          "type": "string"
        },
        "dynamic": {
          "type": "boolean"
        },
        "boxes": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "can_replace": {
          "type": "boolean"
        },
        "can_place_at": {
          "type": "boolean",
          "default": true
        },
        "facing": {
          "enum": [
            "none",
            "horizontal",
            "all",
            "player"
          ]
        },
        "waterloggable": {
          "type": "boolean"
        },
        "rotate_with_player": {
          "type": "boolean"
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "texture": {
          "$ref": "#/$defs/texture"
        },
        "variant_textures": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/texture"
          }
        },
        "render_layer": {
          "enum": [
            "solid",
            "cutout",
            "cutout_mipped",
            "translucent"
          ]
        },
        "translucent": {
          "type": "boolean"
        },
        "cutout": {
          "type": "boolean"
        },
        "emissive": {
          "type": "boolean"
        },
        "tint": {
          "type": "string"
        }
      }
    },
    "texture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "enum": [
            "local",
            "remote"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^[^/\\\\][^:]*\\.(png|jpg|jpeg)$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216,
          "default": 1048576
        },
        "fallback": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_/.-]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "local"
              }
            }
          },
          "then": {
            "required": [
              "path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "remote"
              }
            }
          },
          "then": {
            "required": [
              "url"
            ]
          }
        }
      ]
    },
    "loot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "self",
            "nothing",
            "like",
            "item",
            "table"
          ]
        },
        "item": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_/.-]+$"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "table": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_/.-]+$"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "register": {
          "type": "boolean",
          "default": true
        },
        "max_stack_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_damage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "rarity": {
          "enum": [
            "common",
            "uncommon",
            "rare",
            "epic"
          ]
        },
        "fire_resistant": {
          "type": "boolean"
        }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "description": "Logica do bloco. Cada valor e um arquivo .lua, uma URL https ou o nome de uma funcao exportada pelo entrypoint.",
      "properties": {
        "on_use": {
          "type": "string"
        },
        "on_attack": {
          "type": "string"
        },
        "on_break": {
          "type": "string",
          "description": "Nome antigo de on_attack; ainda aceito."
        },
        "on_placed": {
          "type": "string"
        },
        "on_broken": {
          "type": "string"
        },
        "on_random_tick": {
          "type": "string"
        },
        "on_neighbor_update": {
          "type": "string"
        },
        "on_place": {
          "type": "string",
          "description": "Campo antigo, nunca implementado; use on_placed."
        }
      }
    },
    "itemEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "max_stack_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 64
        },
        "max_damage": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Maior que zero exige max_stack_size igual a 1."
        },
        "rarity": {
          "enum": [
            "common",
            "uncommon",
            "rare",
            "epic"
          ],
          "default": "common"
        },
        "fire_resistant": {
          "type": "boolean",
          "default": false
        },
        "food": {
          "$ref": "#/$defs/food"
        },
        "fuel_burn_time": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32767,
          "default": 0
        },
        "texture": {
          "$ref": "#/$defs/texture"
        },
        "model": {
          "type": "string",
          "default": "item/generated"
        },
        "behavior": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "on_use": {
              "type": "string"
            }
          }
        }
      }
    },
    "food": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nutrition": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "default": 1
        },
        "saturation": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "default": 0.6
        },
        "always_edible": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "creativeTab": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "register": {
          "type": "boolean",
          "default": true
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$",
          "default": "main"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
          "description": "Item mostrado como icone. Vazio usa o primeiro conteudo declarado."
        }
      }
    },
    "importRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$import"
      ],
      "properties": {
        "$import": {
          "type": "string",
          "description": "Caminho relativo a pasta do mod, ou URL https. O objeto e substituido pelo conteudo apontado."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$",
          "description": "Obrigatorio quando $import e uma URL. Fixa o conteudo aceito."
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "description": "Contrato minimo do runtime: dominios e capabilities do MineLoader.",
      "properties": {
        "domains": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$"
          }
        }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "palette",
        "layers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "enum": [
            "bottom_center",
            "corner"
          ],
          "default": "bottom_center"
        },

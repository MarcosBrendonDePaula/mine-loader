{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MarcosBrendonDePaula/mine-loader/main/docs/tutorials/tutorial.schema.json",
  "title": "MineLoader tutorial document",
  "type": "object",
  "required": ["schema", "kind", "id", "index", "eyebrow", "title", "summary", "updated_at", "sources", "contracts", "outcome", "evidence", "beginner", "sections"],
  "properties": {
    "schema": { "const": 1 },
    "kind": { "const": "mine_loader_tutorial" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "index": { "type": "string", "pattern": "^T[1-9][0-9]*$" },
    "eyebrow": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "format": "date" },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "contracts": { "type": "object", "required": ["permissions", "capabilities", "limits"] },
    "outcome": { "type": "object", "required": ["icon", "label", "title", "text"] },
    "evidence": { "type": "object", "required": ["kind", "label", "meta"] },
    "beginner": { "type": "object", "required": ["prerequisites", "files", "success", "next"], "properties": { "prerequisites": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "success": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "next": { "type": "object", "required": ["href", "label", "text"], "properties": { "href": { "type": "string", "pattern": "^/docs/" }, "label": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 } } } } },
    "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["id", "title", "layout"],
      "properties": {
        "id": { "type": "string", "pattern": "^T[1-9][0-9]*\\.[1-9][0-9]*$" },
        "title": { "type": "string", "minLength": 1 },
        "layout": { "enum": ["split", "code", "table"] },
        "lead": { "type": "string" },
        "paragraphs": { "type": "array", "items": { "type": "string" } },
        "code": { "type": "object", "required": ["language", "value"] },
        "table": { "type": "object", "required": ["headers", "rows"] },
        "callout": { "type": "object", "required": ["tone", "title", "text"], "properties": { "tone": { "enum": ["default", "warning", "proof"] } } }
      }
    }
  }
}
